FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     scalarTransportFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         250;

deltaT          0.025;

adjustTimeStep  no;

writeControl    timeStep;

writeInterval   200;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

functions
{
    tracerBounds
    {
        type            fieldMinMax;
        libs            ( fieldFunctionObjects );
        fields          ( T );
        mode            component;
        location        false;
        log             false;
        writePrecision  12;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;
    }
    tracerInventory
    {
        type            volFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      all;
        operation       volIntegrate;
        fields          ( T );
        writeFields     false;
        log             false;
        writePrecision  12;
        writeControl    timeStep;
        writeInterval   1;
    }
    waferLine
    {
        type            sets;
        libs            ( sampling );
        interpolationScheme cellPoint;
        setFormat       raw;
        fields          ( T );
        writeControl    timeStep;
        writeInterval   40;
        sets            ( aboveWafer { type uniform ; axis x ; start ( 0.02 0.002 0.0005 ) ; end ( 0.08 0.002 0.0005 ) ; nPoints 101 ; } );
    }
    inletTracerAdvection
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            inlet;
        operation       weightedSum;
        weightField     phi;
        fields          ( T );
        writeFields     false;
        log             false;
        writePrecision  12;
        writeControl    timeStep;
        writeInterval   1;
    }
    leftTracerAdvection
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            outletLeft;
        operation       weightedSum;
        weightField     phi;
        fields          ( T );
        writeFields     false;
        log             false;
        writePrecision  12;
        writeControl    timeStep;
        writeInterval   1;
    }
    rightTracerAdvection
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            outletRight;
        operation       weightedSum;
        weightField     phi;
        fields          ( T );
        writeFields     false;
        log             false;
        writePrecision  12;
        writeControl    timeStep;
        writeInterval   1;
    }
    inletAdjacentCells
    {
        type            probes;
        libs            ( sampling );
        fields          ( T );
        interpolationScheme cell;
        fixedLocations  true;
        includeOutOfBounds true;
        writePrecision  12;
        writeControl    timeStep;
        writeInterval   1;
        probeLocations
        (
            (0.04525 0.04975 0.0005)
            (0.04575 0.04975 0.0005)
            (0.04625 0.04975 0.0005)
            (0.04675 0.04975 0.0005)
            (0.04725 0.04975 0.0005)
            (0.04775 0.04975 0.0005)
            (0.04825 0.04975 0.0005)
            (0.04875 0.04975 0.0005)
            (0.04925 0.04975 0.0005)
            (0.04975 0.04975 0.0005)
            (0.05025 0.04975 0.0005)
            (0.05075 0.04975 0.0005)
            (0.05125 0.04975 0.0005)
            (0.05175 0.04975 0.0005)
            (0.05225 0.04975 0.0005)
            (0.05275 0.04975 0.0005)
            (0.05325 0.04975 0.0005)
            (0.05375 0.04975 0.0005)
            (0.05425 0.04975 0.0005)
            (0.05475 0.04975 0.0005)
        );
    }
}


