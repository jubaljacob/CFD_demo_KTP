FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}

solvers
{
    T
    {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-10;
        relTol 0;
    }
}
SIMPLE
{
    nNonOrthogonalCorrectors 0;
    // scalarTransportFoam uses this control object for a TRANSIENT solve.
    // Do not add residualControl: run to the stated physical endTime.
}
// No relaxation: each time step solves the full discrete transient equation.
