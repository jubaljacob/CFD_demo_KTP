boundary
(
    // Offset top opening: x = 0.025 to 0.035 m, y = 0.05 m.
    inlet
    {
        type patch;
        faces
        (
            (14 32 33 15)
        );
    }

    // Left opening: x = 0, y = 0 to 0.01 m.
    outletLeft
    {
        type patch;
        faces
        (
            (0 18 24 6)
        );
    }

    // Right opening: x = 0.10 m, y = 0 to 0.01 m.
    outletRight
