// Offset-inlet comparison: centre x=0.03 m; width 0.01 m.
// The physical grid spacing, wafer, outlets, chamber and depth are unchanged.
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object blockMeshDict;
}

