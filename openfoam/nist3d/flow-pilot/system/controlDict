FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application simpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
// Steady solver labels below count iterations, not physical seconds.
endTime 600;
deltaT 1;
writeControl timeStep;
writeInterval 100;
purgeWrite 0;
writeFormat ascii;
writePrecision 12;
writeCompression off;
timeFormat general;
timePrecision 8;
runTimeModifiable true;
functions
{
    inlet1_sum
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        regionType patch;
        name inlet1;
        operation sum;
        fields (phi);
        writeFields false;
        log true;
        writePrecision 14;
        writeControl timeStep;
        writeInterval 20;
    }
