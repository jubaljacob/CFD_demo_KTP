FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object p;
}

// Kinematic gauge pressure. Absolute operating pressure only selects properties.
dimensions [0 2 -2 0 0 0 0];
internalField uniform 0;
boundaryField
{
    inlet1 { type zeroGradient; }
    inlet2 { type zeroGradient; }
    inlet3 { type zeroGradient; }
    inlet4 { type zeroGradient; }
inlet5 { type zeroGradient; }
    outlet1 { type fixedValue; value uniform 0; }
    outlet2 { type fixedValue; value uniform 0; }
    wafer { type zeroGradient; }
    support { type zeroGradient; }
    walls { type zeroGradient; }
}
